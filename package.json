{
  "name": "@airplanegobrr/rclone-api",
  "version": "1.0.0",
  "description": "Simple module to interact with the rclone RC REST API.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AirplaneGobrr-Trash/rclone-api.git"
  },
  "keywords": [
    "rclone",
    "api",
    "rest",
    "rc",
    "remote-control",
    "backup",
    "sync",
    "wrapper",
    "rclone-api"
  ],
  "author": "AirplaneGobrr",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
